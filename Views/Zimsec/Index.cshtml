@model PindahWebsite3.ViewModels.ZimsecIndexViewModel
@{
    ViewData["Title"] = "Zimsec & Cambridge Past Papers Library";
    ViewData["Description"] = "Sign in to browse Zimsec and Cambridge past papers, marking schemes, and study resources.";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/zimsec.css" asp-append-version="true" />
}

<div class="zimsec-landing">
    <div class="zimsec-landing-hero">
        <div class="container py-4 py-md-5">
            <div class="row align-items-center g-4">
                <div class="col-lg-7 text-center text-lg-start">
                    <div class="zimsec-logo-wrap mb-3">
                        <img src="~/images/modules/zimsec_logo.jpg" alt="Zimsec" class="zimsec-logo" />
                    </div>
                    <h1 class="zimsec-title mb-2">Past Papers Library</h1>
                    <p class="zimsec-lead mb-3">Zimsec &amp; Cambridge resources for O Level and A Level students. Sign in with your student number to browse and search @Model.TotalDocuments.ToString("N0") papers across @Model.TotalSubjects subjects.</p>
                    <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-lg-start">
                        <span class="zimsec-stat-pill">O Level</span>
                        <span class="zimsec-stat-pill">A Level</span>
                        <span class="zimsec-stat-pill">Full-text search</span>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="zimsec-auth-card">
                        <ul class="nav nav-pills nav-fill mb-3 zimsec-auth-tabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="login-tab" data-bs-toggle="pill" data-bs-target="#login-pane" type="button" role="tab">Sign in</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="register-tab" data-bs-toggle="pill" data-bs-target="#register-pane" type="button" role="tab">Register</button>
                            </li>
                        </ul>

                        @if (!string.IsNullOrEmpty(Model.RegisterSuccess))
                        {
                            <div class="alert alert-success py-2 small">@Model.RegisterSuccess</div>
                        }

                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="login-pane" role="tabpanel">
                                @if (!string.IsNullOrEmpty(Model.LoginError))
                                {
                                    <div class="alert alert-danger py-2 small">@Model.LoginError</div>
                                }
                                <form asp-action="Login" method="post">
                                    @Html.AntiForgeryToken()
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold">Student number</label>
                                        <input type="text" name="studentNumber" class="form-control" placeholder="e.g. ZIM12345" required autocomplete="username" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold">Password</label>
                                        <input type="password" name="password" class="form-control" required autocomplete="current-password" />
                                    </div>
                                    <button type="submit" class="btn btn-zimsec-primary w-100 fw-semibold">Access library</button>
                                </form>
                            </div>
                            <div class="tab-pane fade" id="register-pane" role="tabpanel">
                                @if (!string.IsNullOrEmpty(Model.RegisterError))
                                {
                                    <div class="alert alert-danger py-2 small">@Model.RegisterError</div>
                                }
                                <form asp-action="Register" method="post">
                                    @Html.AntiForgeryToken()
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold">Student number</label>
                                        <input type="text" name="studentNumber" class="form-control" placeholder="Your school student number" required autocomplete="username" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold">Password</label>
                                        <input type="password" name="password" class="form-control" minlength="6" required autocomplete="new-password" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold">Confirm password</label>
                                        <input type="password" name="confirmPassword" class="form-control" minlength="6" required autocomplete="new-password" />
                                    </div>
                                    <button type="submit" class="btn btn-outline-zimsec w-100 fw-semibold">Create account</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container pb-5">
        <h2 class="h5 fw-bold mb-3">Browse by level &amp; subject</h2>
        <p class="text-muted small mb-4">Preview of available folders. Sign in to open papers and use advanced search inside documents.</p>
        <div class="row g-3">
            @foreach (var level in Model.PreviewTree)
            {
                <div class="col-md-6">
                    <div class="zimsec-preview-level">
                        <h3 class="h6 fw-bold mb-2">@level.DisplayName</h3>
                        <div class="zimsec-subject-chips">
                            @foreach (var subject in level.Subjects.Take(12))
                            {
                                <span class="zimsec-chip">@subject.DisplayName <small>(@subject.DocumentCount)</small></span>
                            }
                            @if (level.Subjects.Count > 12)
                            {
                                <span class="zimsec-chip zimsec-chip-muted">+@(level.Subjects.Count - 12) more</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @if (!string.IsNullOrEmpty(Model.RegisterError))
    {
        <script>document.getElementById('register-tab')?.click();</script>
    }
}
