@model PindahWebsite3.ViewModels.ZimsecDocumentViewModel
@{
    ViewData["Title"] = Model.Title;
    Layout = "_Layout";
    var pdfUrl = Url.Action("StreamPdf", new { id = Model.Id })!;
}

@section Styles {
    <link rel="stylesheet" href="~/css/zimsec.css" asp-append-version="true" />
}

<div class="zimsec-viewer-page container-fluid px-0 px-md-3 py-3">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start gap-2 mb-3 px-2 px-md-0">
        <div>
            <h1 class="h5 fw-bold mb-1">@Model.Title</h1>
            <p class="text-muted small mb-0">@Model.LevelDisplay › @Model.SubjectDisplay · @((Model.FileSizeBytes / 1024.0 / 1024.0).ToString("0.##")) MB · @Model.PageCount pages</p>
        </div>
        <a href="@Model.ReturnUrl" class="btn btn-sm btn-outline-secondary flex-shrink-0">&larr; Back</a>
    </div>

    <div class="zimsec-pdf-viewer"
         data-pdf-url="@pdfUrl"
         data-page-count="@Model.PageCount">
        <div class="zimsec-pdf-toolbar">
            <button type="button" class="btn btn-sm btn-outline-secondary zimsec-pdf-prev" disabled aria-label="Previous page">&larr;</button>
            <span class="zimsec-pdf-page-indicator" aria-live="polite">Page 1</span>
            <button type="button" class="btn btn-sm btn-outline-secondary zimsec-pdf-next" disabled aria-label="Next page">&rarr;</button>
            <a href="@pdfUrl" class="btn btn-sm btn-outline-secondary zimsec-pdf-open" target="_blank" rel="noopener">Open</a>
            <a href="@pdfUrl" class="btn btn-sm btn-zimsec-primary zimsec-pdf-download" download>Download</a>
        </div>
        <div class="zimsec-pdf-status" role="status">Loading document…</div>
        <div class="zimsec-pdf-pages"></div>
        <div class="zimsec-pdf-fallback d-none">
            <p class="small text-muted mb-2">In-browser preview is unavailable on this device. Open or download the PDF instead.</p>
            <div class="d-flex flex-wrap gap-2">
                <a href="@pdfUrl" class="btn btn-sm btn-zimsec-primary" target="_blank" rel="noopener">Open PDF</a>
                <a href="@pdfUrl" class="btn btn-sm btn-outline-secondary" download>Download PDF</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/pdfjs/pdf.min.js" asp-append-version="true"></script>
    <script src="~/js/zimsec-pdf-viewer.js" asp-append-version="true"></script>
}
