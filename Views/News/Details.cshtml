@model News

@{
    ViewData["Title"] = ViewData["Title"] ?? Model.Heading;
    ViewData["OgType"] = "article";
    ViewData["OgImage"] = Model.CoverImageUrl;
    ViewData["Author"] = Model.AuthorDisplayName;
    ViewData["PublishedTime"] = (Model.DatePublished ?? Model.DateCreated).ToString("yyyy-MM-ddTHH:mm:ssZ");
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">News</a></li>
            <li class="breadcrumb-item active" aria-current="page">Article</li>
        </ol>
    </nav>

    <article itemscope itemtype="https://schema.org/Article">
        @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
        {
            <img src="@Model.CoverImageUrl" class="img-fluid rounded mb-4 w-100" alt="@Model.Heading" style="max-height: 400px; object-fit: cover;" itemprop="image" />
        }

        <h1 class="mb-3" itemprop="headline">@Model.Heading</h1>
        
        <meta itemprop="datePublished" content="@((Model.DatePublished ?? Model.DateCreated).ToString("yyyy-MM-ddTHH:mm:ssZ"))" />
        <meta itemprop="author" content="@Model.AuthorDisplayName" />
        <meta itemprop="publisher" content="Pindah Private Limited" />

        <p class="text-muted mb-4">
            <i class="bi bi-calendar"></i> Published on @((Model.DatePublished ?? Model.DateCreated).ToString("MMMM dd, yyyy"))
            <span class="mx-2">·</span>
            <i class="bi bi-person"></i> @Model.AuthorDisplayName
            @if (Model.IsFeatured)
            {
                <span class="badge text-bg-warning ms-2">Featured</span>
            }
            @if (Model.Status != NewsStatus.Published)
            {
                <span class="badge text-bg-secondary ms-2">@Model.Status (preview)</span>
            }
        </p>

        <div class="article-content">
            @{
                var trimmedContent = Model.Content.TrimStart();
                var isHtml = trimmedContent.StartsWith("<") && Model.Content.Contains('>');
            }
            @if (isHtml)
            {
                @Html.Raw(Model.Content)
            }
            else
            {
                @foreach (var paragraph in Model.Content.Split(new[] { "\r\n\r\n", "\n\n" }, StringSplitOptions.RemoveEmptyEntries))
                {
                    var trimmed = paragraph.Trim();
                    if (!string.IsNullOrEmpty(trimmed))
                    {
                        <p>@trimmed</p>
                    }
                }
            }
        </div>
    </article>

    <div class="mt-5">
        <a asp-action="Index" class="btn btn-outline-secondary">&larr; Back to News</a>
    </div>
</div>
