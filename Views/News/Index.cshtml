@model List<News>

@{
    ViewData["Title"] = ViewData["Title"] ?? "Enterprise Software News & Insights | Pindah Blog";
    ViewData["OgType"] = "website";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-blog-default.jpg";
}

<div class="container py-4">
    <header class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <h1 class="mb-2">Enterprise Software News & Insights</h1>
            <p class="lead text-muted mb-0">Real-world case studies, implementation insights, and ROI metrics for ERP, CRM, Manufacturing, Insurance, and digital transformation in Zimbabwe.</p>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="Generate" class="btn btn-primary btn-sm px-3 flex-shrink-0">Generate article</a>
        }
    </header>
    
    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var article in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(article.CoverImageUrl))
                        {
                            <img src="@article.CoverImageUrl" class="card-img-top" alt="@article.Heading" style="height: 180px; object-fit: cover;" loading="lazy" />
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@article.Heading</h5>
                            <p class="card-text text-muted small mb-2">
                                <i class="bi bi-calendar"></i> @article.DateCreated.ToString("MMMM dd, yyyy")
                            </p>
                            @{
                                var excerpt = System.Text.RegularExpressions.Regex.Replace(article.Content, "<[^>]*>", " ");
                                excerpt = System.Text.RegularExpressions.Regex.Replace(excerpt, @"\s+", " ").Trim();
                            }
                            <p class="card-text flex-grow-1">
                                @(excerpt.Length > 150 ? excerpt[..150] + "..." : excerpt)
                            </p>
                            <a asp-action="Details" asp-route-slug="@article.Slug" class="btn btn-outline-primary btn-sm mt-auto">Read More</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            No news articles available yet. Articles are generated automatically by our AI system.
        </div>
    }
</div>
