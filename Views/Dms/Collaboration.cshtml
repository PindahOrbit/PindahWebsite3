@{
    ViewData["Title"] = "Document Collaboration and Sharing | DMS | Pindah";
    ViewData["Description"] = "Secure document collaboration with internal and external sharing, annotation tools, co-authoring capabilities, and email integration for team productivity.";
    ViewData["Keywords"] = "document collaboration, document sharing, document annotation, co-authoring, team collaboration, external sharing";
    ViewData["CanonicalUrl"] = "https://pindah.org/dms/collaboration";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/dms">DMS</a></li>
                <li class="breadcrumb-item active">Collaboration</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">Document Collaboration and Sharing</h1>
        <p class="lead mb-4">
            Team productivity enhancement through controlled sharing, annotation tools, and 
            co-authoring capabilities enabling efficient document collaboration without compromising 
            security or version integrity.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Internal and External Sharing</h2>
        <p>
            Internal link sharing enables colleagues to access documents directly with permissions 
            respecting existing access controls. Links incorporate expiry dates ensuring temporary 
            access automatically terminates after business needs conclude.
        </p>
        <p>
            External sharing extends collaboration beyond organizational boundaries with password 
            protection and view-only restrictions. Recipients access documents through secure portals 
            without requiring system accounts maintaining security while enabling business partner 
            collaboration.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Annotation and Review</h2>
        <p>
            Document annotation tools enable comments, highlights, and markup without modifying 
            original document content. Reviewers provide feedback through layer-based annotations 
            that can be shown, hidden, or accepted into the master document through formal approval.
        </p>
        <p>
            Annotation threads support conversation around specific document sections with 
            notification workflows alerting authors to new feedback. This structured review 
            process accelerates document refinement while maintaining clear audit trails 
            of who suggested which changes.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Co-Authoring and Integration</h2>
        <p>
            Real-time co-authoring enables multiple users to edit Office documents simultaneously 
            with WebDAV integration providing familiar editing interfaces. Changes synchronize 
            instantly across users with presence indicators showing who is editing which sections.
        </p>
        <p>
            Email integration allows users to attach documents from the DMS directly to messages 
            without downloading and re-uploading. This maintains document control while simplifying 
            the communication workflow users already understand.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/dms" class="text-decoration-none">← Back to DMS</a>
        </p>
    </div>
</div>
