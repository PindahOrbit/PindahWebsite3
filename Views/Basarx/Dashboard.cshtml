@{
    ViewData["Title"] = "BasaRx Pharmacy Command Center | Real-Time Dispensary KPIs | Pindah";
    ViewData["Description"] = "BasaRx Command Center — today's dispenses and value, pending verification, awaiting collection, refill risk, low stock, and batches expiring within 90 days in one pharmacy operations dashboard.";
    ViewData["Keywords"] = "pharmacy dashboard Zimbabwe, dispensary KPIs, pharmacy command center, BasaRx dashboard, refill overdue alerts, pharmacy expiry tracking";
    ViewData["CanonicalUrl"] = "https://pindah.org/basarx/dashboard";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/basarx">BasaRx</a></li>
                <li class="breadcrumb-item active">Command Center</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">Pharmacy Command Center</h1>
        <p class="lead mb-4">
            Real-time visibility across scripts in flight — so pharmacists, managers, and owners
            see verification backlog, collection queues, refill compliance, and stock risk before
            they become patient or cash-flow problems.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Today’s dispensary pulse</h2>
        <p>
            Track dispenses completed today and their value, broken down by status. Pending
            pharmacist verification and scripts awaiting collection stay visible so the counter
            never loses a verified pack or an unpaid shortfall. Status charts show the shape of
            your queue — Dispensed, Verified, Collected, Awaiting POS, On Hold — without exporting
            to a spreadsheet.
        </p>
        <p>
            Jump straight into Quick Dispense, dispensing records, or refill queues from the same
            screen so operational decisions turn into action in one click.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Refill and stock risk</h2>
        <p>
            Pending and overdue refills surface alongside low-stock products and batches approaching
            expiry within 90 days. That combination keeps chronic therapy compliance and FEFO
            discipline on the same operational board as daily throughput.
        </p>
        <p>
            Recent activity gives supervisors an audit-friendly trail of who dispensed, verified,
            collected, or held a script — supporting both quality governance and shift handovers.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">One view for retail and clinic pharmacy</h2>
        <p>
            Whether you run a standalone retail pharmacy or a hospital dispensary sharing patients
            with the EHR module, the Command Center uses the same invoice-backed dispense model.
            Filters keep multi-till and multi-location sites focused on the work that matters for
            this shift.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/basarx" class="text-decoration-none">← Back to BasaRx</a>
        </p>
    </div>
</div>
