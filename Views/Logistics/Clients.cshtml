@{
    ViewData["Title"] = "Customer Logistics Portal & Real-Time Tracking | Pindah";
    ViewData["Description"] = "Empower your clients with a dedicated logistics portal. Real-time delivery tracking, digital proof of delivery (POD), and historical shipping records.";
    ViewData["Keywords"] = "client logistics portal, customer delivery tracking, real-time shipping view, digital POD for clients, logistics transparency";
    ViewData["CanonicalUrl"] = "https://pindah.org/logistics/clients";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/logistics">Logistics</a></li>
                <li class="breadcrumb-item active">Clients</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">Customer Logistics Portal</h1>
        <p class="lead mb-4">
            Build customer trust through radical transparency, providing your clients with direct 
            access to their distribution history and live delivery progress.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Self-Service Delivery Tracking</h2>
        <p>
            Eliminate the volume of status-check calls with a dedicated self-service portal. 
            Clients can log in to view the live status of their active orders, including 
            expected time of arrival (ETA) and the current location of the assigned 
            vehicle on a map. This real-time accessibility improves client 
            satisfaction and reduces the administrative burden on your dispatch 
            team.
        </p>
        <p>
            Automated notifications via SMS or WhatsApp alert clients when their delivery 
            has departed the depot or is within a 5-kilometer radius, ensuring they are 
            prepared for the handover.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Digital Documentation & History</h2>
        <p>
            Provide your clients with a secure archive of their shipping interactions. The portal 
            allows customers to view and download historical Proof of Delivery (POD) documents, 
            including capture signatures and photos, for their own record-keeping and 
            audit purposes. This instant availability of documentation accelerates client 
            onward processes and reduces billing disputes.
        </p>
        <p>
            Historical performance dashboards show customers their own order success rates and 
            average transit times, demonstrating your organization's commitment to 
            service excellence and transparency.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Collaboration & Feedback</h2>
        <p>
            The Client Portal serves as a focused communication channel. Customers can 
            submit specific delivery instructions, request rescheduling, and provide 
            immediate feedback or ratings on their delivery experience. This direct 
            feedback loop is invaluable for quality control and provides the 
            data needed to refine your logistics operations based on genuine 
            customer sentiment.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/logistics" class="text-decoration-none">← Back to Logistics</a>
        </p>
    </div>
</div>
