@{
    ViewData["Title"] = "Logistics Performance Dashboard & KPIs | Pindah";
    ViewData["Description"] = "Real-time logistics dashboard tracking delivery order health, on-time rates (OTD), fleet utilization, and operational cost metrics.";
    ViewData["Keywords"] = "logistics dashboard, OTD metrics, delivery analytics, fleet utilization dashboard, logistics KPIs, delivery success tracking";
    ViewData["CanonicalUrl"] = "https://pindah.org/logistics/dashboard";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/logistics">Logistics</a></li>
                <li class="breadcrumb-item active">Dashboard</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">Logistics Performance Dashboard</h1>
        <p class="lead mb-4">
            A high-density strategic overview of your distribution ecosystem, transforming movement 
            data into actionable operational intelligence.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Delivery Order Health & OTD</h2>
        <p>
            Monitor real-time delivery performance across all active routes. The dashboard 
            visualizes On-Time Delivery (OTD) rates compared against client SLAs, 
            flagging delayed trips for immediate dispatcher intervention. By 
            identifying bottlenecks in the loading or transit phases, managers 
            can adjust resources to maintain organizational service commitments.
        </p>
        <p>
            Detailed breakdowns by zone, product category, and vehicle class provide the 
            granular insight needed to understand delivery variance and improve 
            overall supply chain reliability.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Fleet & Asset Utilization</h2>
        <p>
            Gain visibility into the efficiency of your physical assets. Track vehicle idle 
            times, average return-to-base durations, and kilometer-per-trip metrics. 
            Understanding fleet utilization allows for better vehicle maintenance 
            planning and provides the data required to justify fleet expansion 
            or consolidation strategies.
        </p>
        <p>
            Live alerts for critical maintenance schedules and regulatory renewals ensure 
            that asset utilization does not come at the expense of safety or legal 
            compliance.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/logistics" class="text-decoration-none">← Back to Logistics</a>
        </p>
    </div>
</div>
