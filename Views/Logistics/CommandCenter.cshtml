@{
    ViewData["Title"] = "Logistics Command Center | Live Fleet Monitoring | Pindah";
    ViewData["Description"] = "The high-level hub for real-time logistics operations. Monitor live vehicle locations, trip progress, and geofence alerts on a dynamic map interface.";
    ViewData["Keywords"] = "logistics command center, live fleet tracking, dispatch control hub, real-time vehicle monitoring, logistics map interface, geofencing alerts";
    ViewData["CanonicalUrl"] = "https://pindah.org/logistics/commandcenter";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/logistics">Logistics</a></li>
                <li class="breadcrumb-item active">Command Center</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">Logistics Command Center</h1>
        <p class="lead mb-4">
            The mission control for your distribution network, providing absolute live visibility 
            of every asset, trip, and delivery event across the enterprise.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Centralized Live Map Visibility</h2>
        <p>
            Experience a unified, real-time view of your entire logistics landscape. The Logistics 
            Command Center features a high-fidelity dynamic map that displays live vehicle 
            positions, current trip trajectories, and pending delivery points. This 
            unprecedented level of visibility allows dispatchers to identify 
            congestion, track progress against ETAs, and respond to incidents as they 
            unfold on the ground.
        </p>
        <p>
            Markers are updated via ultra-low latency streams from driver mobile terminals, 
            providing a smooth, animated representation of your fleet's movement across 
            the territory.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Incident Response & Alerts</h2>
        <p>
            The Command Center is more than a map; it is an intelligent alerting hub. System-level 
            proactive alerts highlight speed violations, route deviations, and unauthorized 
            stops as they happen. Dispatchers can communicate directly with drivers through 
            integrated messaging, providing new instructions or re-routing data in 
            response to traffic conditions or changing customer priorities.
        </p>
        <p>
            Geofence status indicators show exactly when a vehicle has arrived at its 
            destination point or entered a critical zone (such as a customer site or 
            distribution hub), automating the timeline of every delivery event.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Dispatcher Collaboration Hub</h2>
        <p>
            Coordinate high volumes of delivery orders with specialized tools designed for 
            dispatch professionals. View trip manifests, driver contact details, and vehicle 
            health status in side-panels without losing sight of the map. Integrated 
            search and filtering allow you to focus on specific territories, 
            vehicle classes, or high-priority clients, maintaining control even 
            during peak fulfillment cycles.
        </p>
        <p>
            Historical route replay capabilities allow for the post-trip analysis of 
            incidents or performance issues, providing an authoritative record of 
            movement data for dispute resolution and insurance purposes.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/logistics" class="text-decoration-none">← Back to Logistics</a>
        </p>
    </div>
</div>
