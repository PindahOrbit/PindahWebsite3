@{
    ViewData["Title"] = "Healthcare Executive Dashboard & Bed Monitoring | Pindah";
    ViewData["Description"] = "Real-time executive oversight for hospitals and clinics. Track bed occupancy, patient volumes, pharmacy stock levels, and clinical turnaround times.";
    ViewData["Keywords"] = "hospital dashboard, bed occupancy tracking, patient volume analytics, clinical KPIs, ward utilization report, medicine stock dashboard";
    ViewData["CanonicalUrl"] = "https://pindah.org/hospital/dashboard";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/hospital">Health</a></li>
                <li class="breadcrumb-item active">Dashboard</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">Healthcare Executive Dashboard</h1>
        <p class="lead mb-4">
            Transform disparate clinical and administrative data into a high-fidelity operational 
            center, providing real-time visibility into the pulse of your healthcare facility.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Ward Capacity & Bed Occupancy</h2>
        <p>
            Gain immediate visibility into your inpatient capacity. The dashboard provides a live 
            visual representation of bed occupancy across all wards—General, Pediatric, Maternity, 
            High Dependency (HDU), and Intensive Care (ICU). Monitor admission and discharge 
            velocity alongside average 'Length of Stay' (LOS) metrics, identifying potential 
            ward bottlenecks early and optimizing patient throughput.
        </p>
        <p>
            Real-time 'Reserved' and 'Blocked' bed status ensures that the admissions desk always 
            has the most accurate information when coordinating incoming referrals or 
            emergency cases.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Clinical Throughput & Departmental Load</h2>
        <p>
            Track patient volumes and waiting times throughout the facility. The dashboard 
            visualizes load across Triage, Outpatient Consultation rooms, and diagnostic 
            units (Lab/Radiology). Monitoring average 'Turnaround Time' (TAT) for test 
            results and physician encounters allows clinical management to redistribute 
            staffing levels dynamically, maintaining high standards of delivery 
            even during peak periods.
        </p>
        <p>
            Live tracking of 'Unread Reports' and 'Open Consultations' ensures that no 
            patient care pathway is inadvertently delayed, prioritizing patient safety through 
            operational transparency.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Critical Pharmaceutical Oversight</h2>
        <p>
            Maintain the continuity of care through intelligent stock monitoring. The dashboard 
            highlights critical medication shortages and upcoming expiry dates across the 
            Pharmacy and ward dispensaries. Real-time visualization of inventory turnover 
            values and procurement velocity ensures that essential life-saving 
            medications are always in stock while minimizing waste from expired inventory.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/hospital" class="text-decoration-none">← Back to Hospital Management</a>
        </p>
    </div>
</div>
