@model List<VideoGuide>
@using PindahWebsite3.Services
@{
    ViewData["Title"] = ViewData["Title"] ?? "Video Guides | Pindah Product Tutorials";
    ViewData["OgType"] = "website";
    var isAdmin = User.IsInRole(CmsConstants.RoleAdmin);
}

<div class="container py-4">
    <header class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <h1 class="mb-2">Video Guides</h1>
            <p class="lead text-muted mb-0">Product walkthroughs and how-to videos from Pindah. Paste a YouTube link in the CMS and it appears here.</p>
        </div>
        @if (isAdmin)
        {
            <a class="btn btn-outline-primary btn-sm" asp-area="Admin" asp-controller="VideoGuides" asp-action="Index">Manage in CMS</a>
        }
    </header>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                var embedUrl = YouTubeUrlHelper.GetEmbedUrl(item.YouTubeUrl);
                <div class="col-12 col-lg-6">
                    <article class="video-guide-card h-100">
                        @if (!string.IsNullOrWhiteSpace(item.Category))
                        {
                            <p class="small text-uppercase text-muted mb-1">@item.Category</p>
                        }
                        <h2 class="h5 mb-2">@item.Title</h2>
                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <p class="text-muted small mb-3">@item.Description</p>
                        }
                        @if (embedUrl != null)
                        {
                            <div class="ratio ratio-16x9 mb-2">
                                <iframe
                                    src="@embedUrl"
                                    title="@item.Title"
                                    loading="lazy"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                    allowfullscreen
                                    referrerpolicy="strict-origin-when-cross-origin"></iframe>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning small mb-2">This video link could not be embedded.</div>
                        }
                        <p class="mb-0 small text-muted">
                            <a href="@item.YouTubeUrl" target="_blank" rel="noopener noreferrer">Watch on YouTube</a>
                            · Added @item.DateAdded.ToString("MMMM dd, yyyy")
                        </p>
                    </article>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            No video guides are published yet.
        </div>
    }
</div>

@section Styles {
    <style>
        .video-guide-card {
            padding: 1rem 0;
            border-bottom: 1px solid var(--bs-border-color);
        }
        @@media (min-width: 992px) {
            .video-guide-card {
                padding: 0;
                border-bottom: 0;
            }
        }
    </style>
}
