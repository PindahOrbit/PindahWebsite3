@{
    ViewData["Title"] = "School Performance Dashboard & Enrollment Analytics | Pindah";
    ViewData["Description"] = "Real-time executive oversight for school administration. Track enrollment trends, fee collection velocity, academic performance profiles, and daily attendance.";
    ViewData["Keywords"] = "school dashboard, education KPIs, student enrollment analytics, fee collection report, school attendance dashboard, academic performance summary";
    ViewData["CanonicalUrl"] = "https://pindah.org/sms/dashboard";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/sms">SMS</a></li>
                <li class="breadcrumb-item active">Dashboard</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">School Performance Dashboard</h1>
        <p class="lead mb-4">
            Transform disparate school data into high-fidelity institutional insight, providing 
            academic and administrative leadership with real-time visibility into the health 
            of the campus.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Enrollment & Demographic Vitality</h2>
        <p>
            Monitor real-time enrollment metrics across all forms and grades. The dashboard 
            visualizes current student strength against facility capacity, identifying 
            under-capacity levels or enrollment bottlenecks instantly. Grouped 
            demographic data provides the transparency needed for institutional 
            reporting, identifying trends in admissions growth and historical 
            cohort retention across the academic journey.
        </p>
        <p>
            Dynamic geographic heatmaps identify the sourcing areas of your student body, 
            providing critical data for transport planning and school marketing 
            strategies.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Fee Collection & Financial Velocity</h2>
        <p>
            Gain absolute visibility into the school's primary revenue stream. The dashboard 
            tracks total fee collections across USD and ZiG accounts compared against 
            termly budgets. Identifying unfavorable collection variances early allows 
            for proactive parental engagement and resource realignment before 
            school operations are impacted.
        </p>
        <p>
            Real-time tracking of top arrears accounts and overall debt aging ensures 
            that the finance office remains focused on organizational liquidity 
            targets.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Academic & Attendance Awareness</h2>
        <p>
            Analyze the heartbeat of clinical and academic activity. Track daily average 
            attendance percentages for both students and staff, highlighting 
            anomalous patterns before they impact academic results. Executive 
            summaries of termly assessments visualize the distribution of grades 
            across the school, identifying high-performing departments and those 
            requiring additional academic stewardship.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/sms" class="text-decoration-none">← Back to School Management</a>
        </p>
    </div>
</div>
