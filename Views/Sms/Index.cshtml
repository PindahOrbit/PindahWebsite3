        <div class="module-landing-accent" aria-hidden="true"></div>
        <p class="module-landing-kicker mb-2">Education & School Administration</p>
        <h1 class="module-landing-headline text-white mb-3">Enterprise School Management (Frame).</h1>
        <p class="module-landing-dek mb-4 col-lg-10 px-0">
            Digitize your school's structural foundation with Frame—an enterprise-grade 
            administration platform engineered for the specific academic and financial 
            realities of the Zimbabwean education sector.
        </p>
        <div class="d-flex flex-wrap gap-2">
            <a href="#components" class="btn btn-light btn-sm px-4 fw-semibold">Module components</a>
            <a href="/#inquiry" class="btn btn-outline-light btn-sm px-4">Start a conversation</a>
        </div>
    </div>
</section>

