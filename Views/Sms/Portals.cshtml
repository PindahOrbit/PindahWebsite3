    ViewData["Description"] = "Integrated self-service portals for the school community. Real-time access to results, fee balances, and WhatsApp chatbot communication.";
    ViewData["Keywords"] = "school parent portal, student self-service app, teacher grading portal, WhatsApp school chatbot, school announcements app, digital report access";
    ViewData["CanonicalUrl"] = "https://pindah.org/sms/portals";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/sms">SMS</a></li>
                <li class="breadcrumb-item active">Portals</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">Community Portals & Engagement</h1>
        <p class="lead mb-4">
            A high-connectivity ecosystem that provides parents, students, and teachers with 
            secure, real-time access to the institutional data that matters most.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">The Parent & Student Empowerment Suite</h2>
        <p>
            Place institutional data directly in the hands of your primary stakeholders. The 
            Parent Portal provides a unified view for families with multiple children, 
            allowing them to monitor academic results, check daily attendance, and 
            review current fee balances and historical payments instantly. Students 
            utilize their own self-service portal to access class timetables, 
            homework assignments, and digital learning resources provided by 
            their teachers.
        </p>
        <p>
            Mobile-responsive design ensures that this the portal is accessible on any device, 
            eliminating the friction of physical office visits for routine 
            information lookups.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">WhatsApp Business Chatbot Integration</h2>
        <p>
            Bridge the information gap through the channel parents use most. Frame's native 
            WhatsApp integration allows authorized parents to query their child's latest 
            results and check fee account balances via a simple automated chat 
            interface. This 24/7 service significantly reduces the administrative 
            burden on the front office while providing parents with immediate, 
            on-demand access to critical school data.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">School Announcements & Circulars</h2>
        <p>
            Digitize your campus communication strategy. The portal serves as the central 
            archive for all official school circulars, announcements, and event 
            calendars, ensuring that the entire school community is aligned with 
            institutional milestones and emergency notices. Multi-channel delivery—synchronizing 
            portal posts with WhatsApp and SMS alerts—guarantees that no 
            parent or student is ever out of the communication loop.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/sms" class="text-decoration-none">← Back to School Management</a>
        </p>
    </div>
</div>
