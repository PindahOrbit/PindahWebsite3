@{
    ViewData["Title"] = "Manufacturing Executive Dashboard & Production OEE | Pindah";
    ViewData["Description"] = "Real-time visibility into factory performance. Track OEE, production yield, work-in-progress (WIP), and machine downtime analytics.";
    ViewData["Keywords"] = "manufacturing dashboard, OEE tracking, WIP monitoring, factory productivity metrics, machine downtime report, production yield analytics";
    ViewData["CanonicalUrl"] = "https://pindah.org/manufacturing/dashboard";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/manufacturing">Manufacturing</a></li>
                <li class="breadcrumb-item active">Dashboard</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">Manufacturing Executive Dashboard</h1>
        <p class="lead mb-4">
            Transform high-volume shop floor data into strategic operational intelligence, providing 
            real-time visibility into the performance, quality, and availability of your 
            production assets.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">OEE & Asset Effectiveness</h2>
        <p>
            Gain immediate visibility into your factory's true capacity through the Overall 
            Equipment Effectiveness (OEE) cockpit. Monitor availability, performance, and 
            quality metrics across all work centers and machine groups. Real-time 
            visualization of planned vs. actual production rates allows shift supervisors 
            to identify slowing lines and target interventions before schedule commitments 
            are missed.
        </p>
        <p>
            Downtime reason-code analysis—categorizing technical failure, material shortage, 
            and changeovers—provides the data necessary for continuous improvement 
            and predictive maintenance strategies.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Work-in-Progress (WIP) & Inventory Status</h2>
        <p>
            Track the financial and physical flow of goods across the shop floor. The WIP 
            dashboard identifies inventory bottlenecks at specific work centers, visualizing 
            the volume of orders currently in staging, processing, and quality quarantine. 
            By monitoring WIP turnover and cycle times, manufacturing leadership can 
            facilitate smoother production flow and reduce the carrying cost 
            of floor-based inventory.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Quality Trends & Yield Analytics</h2>
        <p>
            Maintain rigorous quality standards through proactive yield monitoring. Visualize 'First 
            Pass Yield' (FPY) metrics and scrap rates across different products and 
            shifts. Early detection of quality drift allows for immediate machine 
            calibration or material investigation, protecting the facility's 
            reputational integrity and minimizing waste-related financial 
            losses.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/manufacturing" class="text-decoration-none">← Back to Manufacturing</a>
        </p>
    </div>
</div>
