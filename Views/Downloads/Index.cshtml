@model List<Download>

@{
    ViewData["Title"] = ViewData["Title"] ?? "Downloads | Pindah Software & Mobile Apps";
    ViewData["OgType"] = "website";
}

<div class="container py-4">
    <header class="mb-4">
        <h1 class="mb-2">Downloads</h1>
        <p class="lead text-muted mb-0">Mobile apps, installers, and software resources from Pindah.</p>
    </header>

    @if (TempData["DownloadSuccess"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }
    @if (TempData["DownloadError"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="card mb-4 border-primary">
            <div class="card-header bg-primary text-white">Manage downloads</div>
            <div class="card-body">
                <form asp-action="Create" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Title</label>
                        <input type="text" name="Title" class="form-control form-control-sm" required maxlength="200" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">File URL</label>
                        <input type="url" name="FileUrl" class="form-control form-control-sm" required maxlength="500" placeholder="https://storage.pindah.org/..." />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Description</label>
                        <textarea name="Description" class="form-control form-control-sm" rows="2" maxlength="1000"></textarea>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">File type</label>
                        <input type="text" name="FileType" class="form-control form-control-sm" maxlength="50" placeholder="APK, PDF, ZIP" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Platform</label>
                        <input type="text" name="Platform" class="form-control form-control-sm" maxlength="50" placeholder="Android, Windows" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Sort order</label>
                        <input type="number" name="SortOrder" class="form-control form-control-sm" value="0" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input type="hidden" name="IsPublished" value="false" />
                            <input class="form-check-input" type="checkbox" name="IsPublished" value="true" id="downloadPublished" checked />
                            <label class="form-check-label small" for="downloadPublished">Published</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary btn-sm">Add download</button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="list-group">
            @foreach (var item in Model)
            {
                <div class="list-group-item list-group-item-action d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 py-3">
                    <div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <h2 class="h5 mb-0">@item.Title</h2>
                            @if (!string.IsNullOrWhiteSpace(item.FileType))
                            {
                                <span class="badge text-bg-secondary">@item.FileType</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Platform))
                            {
                                <span class="badge text-bg-light border">@item.Platform</span>
                            }
                            @if (User.Identity?.IsAuthenticated == true && !item.IsPublished)
                            {
                                <span class="badge text-bg-warning">Draft</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <p class="mb-1 text-muted small">@item.Description</p>
                        }
                        <p class="mb-0 small text-muted">Added @item.DateAdded.ToString("MMMM dd, yyyy")</p>
                    </div>
                    <div class="d-flex flex-shrink-0 gap-2">
                        <a href="@item.FileUrl" class="btn btn-primary btn-sm" target="_blank" rel="noopener noreferrer" download>Download</a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Remove this download?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Remove</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            No downloads are available yet.
        </div>
    }
</div>
