@model List<Download>

@{
    ViewData["Title"] = ViewData["Title"] ?? "Downloads | Pindah Software & Mobile Apps";
    ViewData["OgType"] = "website";
    var isAdmin = User.IsInRole(CmsConstants.RoleAdmin);
}

<div class="container py-4">
    <header class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <h1 class="mb-2">Downloads</h1>
            <p class="lead text-muted mb-0">Mobile apps, installers, and software resources from Pindah.</p>
        </div>
        @if (isAdmin)
        {
            <a class="btn btn-outline-primary btn-sm" asp-area="Admin" asp-controller="Downloads" asp-action="Index">Manage in CMS</a>
        }
    </header>

    @if (TempData["DownloadSuccess"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }
    @if (TempData["DownloadError"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="list-group">
            @foreach (var item in Model)
            {
                <div class="list-group-item list-group-item-action d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 py-3">
                    <div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <h2 class="h5 mb-0">@item.Title</h2>
                            @if (!string.IsNullOrWhiteSpace(item.FileType))
                            {
                                <span class="badge text-bg-secondary">@item.FileType</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Platform))
                            {
                                <span class="badge text-bg-light border">@item.Platform</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <p class="mb-1 text-muted small">@item.Description</p>
                        }
                        <p class="mb-0 small text-muted">Added @item.DateAdded.ToString("MMMM dd, yyyy")</p>
                    </div>
                    <div class="d-flex flex-shrink-0 gap-2">
                        <a href="@item.FileUrl" class="btn btn-primary btn-sm" target="_blank" rel="noopener noreferrer" download>Download</a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            No downloads are available yet.
        </div>
    }
</div>
