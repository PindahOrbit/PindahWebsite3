@model PindahWebsite3.ViewModels.ProductGuideDetailViewModel

@{
    ViewData["Title"] = ViewData["Title"] ?? $"{Model.Title} | Pindah Basa Product Guide";
}

@section Styles {
    <link rel="stylesheet" href="~/css/product-guides.css" asp-append-version="true" />
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-action="Index">Product Guides</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <p class="small text-muted mb-3">
        Updated @Model.UpdatedUtc.ToString("MMMM dd, yyyy") UTC · Read-only documentation
        @if (Model.HasPdf)
        {
            <span> · </span>
            <a href="/product-guides/@Model.Slug.pdf" download class="link-primary">Download PDF</a>
        }
    </p>

    <article class="product-guide-document">
        @Html.Raw(Model.Html)
    </article>
</div>
