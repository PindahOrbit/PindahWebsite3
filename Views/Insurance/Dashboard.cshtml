@{
    ViewData["Title"] = "Insurance Performance Dashboard & GWP Analysis | Pindah";
    ViewData["Description"] = "Real-time executive dashboard for insurance operations. Track Gross Written Premiums (GWP), claims ratios, underwriting results, and intermediary production.";
    ViewData["Keywords"] = "insurance dashboard, gross written premium tracking, claims ratio analysis, insurance KPIs, underwriting performance, broker production dashboard";
    ViewData["CanonicalUrl"] = "https://pindah.org/insurance/dashboard";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/insurance">Insurance</a></li>
                <li class="breadcrumb-item active">Dashboard</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">Insurance Performance Dashboard</h1>
        <p class="lead mb-4">
            Transform complex insurance data into actionable strategic oversight, providing real-time 
            visibility into the health of your portfolio and profitability of your lines of business.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Premiums & Production Monitoring</h2>
        <p>
            Monitor Gross Written Premiums (GWP) across all product classes and branches. The 
            dashboard visualizes production versus budget, allowing management to identify 
            high-performing segments and those requiring strategic intervention. Detailed 
            breakdowns of new business versus renewals provide a clear picture of 
            portfolio growth and retention health.
        </p>
        <p>
            Native multi-currency reporting segregates USD and ZiG premium tracking, 
            providing a balanced view of financial exposure and cash flow in Zimbabwe's 
            diverse economic environment.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Claims & Loss Ratio Intelligence</h2>
        <p>
            Maintain financial stability through real-time loss ratio tracking. The dashboard 
            correlates earned premiums with incurred claims (paid + reserves) to 
            visualize technical results by underwriter, broker, and product category. 
            Early detection of deteriorating claims ratios allows for rapid pricing 
            corrections or risk appetite adjustments before organizational solvency 
            is impacted.
        </p>
        <p>
            Live tracking of claim volumes and average turnaround times identifies 
            operational bottlenecks, ensuring that your service delivery remains 
            aligned with customer expectations and regulatory standards.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Intermediary & Agency Performance</h2>
        <p>
            Gain absolute visibility into your distribution network. Track production totals and 
            claims ratios for every broker and agent. Intermediary-specific dashboards 
            highlight those bringing in high-quality, profitable business versus those with 
            unfavorable loss profiles, informing commission structures and partnership 
            strategies.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/insurance" class="text-decoration-none">← Back to Insurance</a>
        </p>
    </div>
</div>
