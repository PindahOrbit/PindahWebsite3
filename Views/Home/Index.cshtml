@if (Model.FeaturedNews.Any())
{
    <section class="mb-5" aria-labelledby="insights-heading">
        <p class="section-kicker">Insights</p>
        <h2 class="h3 fw-bold mb-2" id="insights-heading">Enterprise Software News & Insights</h2>
        <p class="lead text-muted mb-3">Real-world case studies, implementation insights, and ROI metrics for ERP, CRM, Manufacturing, Insurance, and digital transformation in Zimbabwe.</p>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var article in Model.FeaturedNews)
            {
                <div class="col">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(article.CoverImageUrl))
                        {
                            <img src="@article.CoverImageUrl" class="card-img-top" alt="@article.Heading" style="height: 180px; object-fit: cover;" loading="lazy" />
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@article.Heading</h5>
                            <p class="card-text text-muted small mb-2">
                                <i class="bi bi-calendar"></i> @article.DateCreated.ToString("MMMM dd, yyyy")
                            </p>
                            @{
                                var excerpt = System.Text.RegularExpressions.Regex.Replace(article.Content, "<[^>]*>", " ");
                                excerpt = System.Text.RegularExpressions.Regex.Replace(excerpt, @"\s+", " ").Trim();
                            }
                            <p class="card-text flex-grow-1">
                                @(excerpt.Length > 150 ? excerpt[..150] + "..." : excerpt)
                            </p>
            <a asp-controller="News" asp-action="Details" asp-route-slug="@article.Slug" class="btn btn-outline-primary btn-sm mt-auto">Read More</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

<section class="home-cta-band mb-5" id="contact" aria-label="Contact Pindah">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <p class="home-landing-kicker mb-2">Get started</p>
                <h2 class="h3 fw-bold mb-3">Ready to Modernize Your Operations?</h2>
                <p class="mb-3 text-muted">
                    If your organization has reached the point where operational infrastructure requires
                    reinvestment, we welcome the conversation. Initial discussions focus on understanding
                    your challenges and determining whether our capabilities align with your requirements.
                </p>
                <p class="mb-0 text-muted">
                    No obligation. No generic presentations. We learn about your operations, you learn
                    about our approach, and we determine next steps together.
                </p>
            </div>
            <div class="col-lg-5">
                <a href="mailto:admin@pindah.org" class="btn btn-primary mb-2">Start a conversation</a>
                <a href="https://wa.me/263714856897" class="btn btn-secondary mb-2" target="_blank" rel="noopener noreferrer">WhatsApp us directly</a>
                <p class="small text-muted mb-0">
                    admin@pindah.org &middot; +263 714 856 897<br />
