                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>Student administration and fee management</span>
                    <span class="badge text-bg-primary">Education</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>Production planning and quality control</span>
                    <span class="badge text-bg-primary">Manufacturing</span>
