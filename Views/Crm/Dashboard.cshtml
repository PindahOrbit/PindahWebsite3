@{
    ViewData["Title"] = "CRM Dashboard & Sales Analytics | Pindah";
    ViewData["Description"] = "Real-time CRM dashboard providing comprehensive visibility into sales pipeline health, conversion metrics, team activity, and key performance indicators.";
    ViewData["Keywords"] = "CRM dashboard, sales analytics, pipeline health, conversion rates, sales KPIs, sales performance monitoring";
    ViewData["CanonicalUrl"] = "https://pindah.org/crm/dashboard";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/crm">CRM</a></li>
                <li class="breadcrumb-item active">Dashboard</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">CRM Dashboard & Sales Analytics</h1>
        <p class="lead mb-4">
            Unified visibility into sales performance and customer engagement through real-time dashboards that 
            aggregate data across all CRM functions.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Real-Time Sales Visibility</h2>
        <p>
            The CRM dashboard consolidates information from every stage of the customer lifecycle, 
            presenting a unified view of organizational sales health. Pipeline values, deal counts, 
            and forecast accuracy update in real time, providing immediate awareness of revenue 
            trajectories without requiring manual data extraction or spreadsheet consolidation.
        </p>
        <p>
            Revenue trends visualize over custom periods, highlighting seasonal patterns, 
            growth trajectories, and areas requiring sales attention. Comparative analysis against 
            quota allocations and historical performance enables context for every figure displayed.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Key Performance Indicators</h2>
        <p>
            Essential sales metrics surface automatically on the dashboard, tailored to organizational 
            priorities. Conversion rates from lead to opportunity (L2O) and opportunity to close (O2C) 
            provide immediate indicators of sales process efficiency. Average deal size and sales 
            cycle duration track performance evolution over time.
        </p>
        <p>
            Custom KPIs can be configured to reflect industry-specific metrics or internal performance 
            targets. Alert thresholds notify sales managers when metrics drift outside acceptable 
            ranges, enabling proactive coaching and intervention rather than reactive response.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Team Productivity and Activity</h2>
        <p>
            Monitor sales team activity levels with integrated tracking of calls made, meetings held, 
            emails sent, and WhatsApp messages exchanged. Leaderboards highlight top performers 
            and encourage healthy competition, while activity ratios identify areas where 
            representative effort may be misaligned with outcome expectations.
        </p>
        <p>
            This 360-degree view of sales operations transforms raw interaction data into 
            strategic commercial intelligence, supporting the optimization of the entire 
            sales organization.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/crm" class="text-decoration-none">← Back to CRM</a>
        </p>
    </div>
</div>
