@{
    ViewData["Title"] = "CRM Quotation & Proposal Management | Pindah";
    ViewData["Description"] = "Generate professional, multi-currency quotations with e-signature integration and seamless conversion from CRM deal to ERP sales order.";
    ViewData["Keywords"] = "CRM quotes, proposal management, sales quotations, e-signature for sales, multi-currency quotes, USD ZiG quotation";
    ViewData["CanonicalUrl"] = "https://pindah.org/crm/quotes";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/crm">CRM</a></li>
                <li class="breadcrumb-item active">Quotes</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">CRM Quotation & Proposal Management</h1>
        <p class="lead mb-4">
            Professional document generation and e-signature workflows that streamline the transition from 
            negotiation to contract, accelerating deal closure.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Multi-Currency Quotation Builder</h2>
        <p>
            Generate branded, professional quotations directly within the CRM using your integrated 
            product and service catalog. The builder supports multi-currency operations natively, 
            allowing for the generation of quotes in USD, ZiG, or other regional currencies with 
            live exchange rate application. Pricing rules ensure that customer-specific 
            discounts and volume breaks are applied automatically, ensuring commercial 
            consistency across the sales team.
        </p>
        <p>
            Quote versioning allows you to track iterations (V1, V2, V3) of a proposal, providing 
            an audit trail of commercial negotiations and allowing for rapid rollback to 
            previously offered terms.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">E-Signature and Digital Acceptance</h2>
        <p>
            Eliminate the friction of "print-sign-scan" with integrated e-signature workflows. 
            Send proposals directly to customer stakeholders via secure links, with real-time 
            tracking of when the document was viewed and signed. Digital acceptance 
            triggers automated notifications to sales, legal, and fulfillment teams, 
            instantaneously moving the deal into the next phase of the project.
        </p>
        <p>
            Automated expiry reminders notify the representative to follow up as the quote's 
            validity period nears its end, ensuring that commercial momentum is maintained 
            throughout the closing cycle.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">ERP Integration and Fulfillment</h2>
        <p>
            Once a quote is signed and accepted, it can be converted into a formal Sales Order or 
            Contract within the integrated ERP system with a single click. This synchronization 
            prevents re-entry errors and ensures that the technical and commercial terms 
            agreed upon by the sales team are accurately communicated to the project 
            delivery and finance departments.
        </p>
        <p>
            Unified catalog management ensures that product codes, descriptions, and pricing 
            align across the entire enterprise, providing a seamless "quote-to-cash" 
            workflow for all business units.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/crm" class="text-decoration-none">← Back to CRM</a>
        </p>
    </div>
</div>
