@{
    ViewData["Title"] = "Lead Management & Capture | CRM | Pindah";
    ViewData["Description"] = "Capture, qualify, and score leads with automated assignment and follow-up tracking. Integrate web forms, WhatsApp, and email for unified lead ingestion.";
    ViewData["Keywords"] = "lead management, lead capture, lead scoring, lead qualification, sales leads, automated lead assignment";
    ViewData["CanonicalUrl"] = "https://pindah.org/crm/leads";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/crm">CRM</a></li>
                <li class="breadcrumb-item active">Leads</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">Lead Management & Capture</h1>
        <p class="lead mb-4">
            Maximize your conversion rates by ensuring that every enquiry is captured, qualified, and 
            assigned with speed and precision.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Multi-Channel Lead Ingestion</h2>
        <p>
            Centralize your lead capture from every possible source. Whether a prospect fills out a 
            website form, sends a WhatsApp message, calls the sales office, or visits a trade 
            show booth, the lead management module ensures no enquiry is lost. Integrated 
            WhatsApp and email capture automatically create lead records, preserving the 
            original context of the enquiry for the sales team.
        </p>
        <p>
            Duplicate detection and merging capabilities maintain account hygiene, ensuring that 
            recurring enquiries from the same prospect are consolidated into a single 
            interaction history.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Scoring and Automated Qualification</h2>
        <p>
            Identify high-value prospects immediately using intelligent lead scoring. Attribute points 
            based on demographic data (company size, industry, location) and engagement signals 
            (email opens, website visits, document downloads). This prioritization allows 
            sales representatives to focus their energy on leads with the highest probability 
             of conversion.
        </p>
        <p>
            Automated qualification workflows filter out non-viable enquiries based on 
            predefined criteria, ensuring that your sales pipeline remains clean and 
            focused on genuine revenue opportunities.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Assignment Rules and SLA Tracking</h2>
        <p>
            Ensure rapid first-contact response through automated assignment rules. Utilize 
            round-robin, territory-based, or product-specific routing to get the lead 
            into the right hands instantly. Task automation creates follow-up 
            requirements on lead arrival, ensuring that no enquiry goes cold.
        </p>
        <p>
            Track Service Level Agreements (SLAs) for response times, providing management 
            with visibility into sales team responsiveness and identifying bottlenecks 
            in the lead-to-deal process. Real-time attribution reporting identifies 
            which marketing sources are producing your most qualified leads.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/crm" class="text-decoration-none">← Back to CRM</a>
        </p>
    </div>
</div>
