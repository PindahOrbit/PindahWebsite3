        <div class="vitrum-container module-feature-img border-0">
            <img src="~/images/vitrum/blue-purple-glass-heart.webp" alt="Sales team collaboration and customer relationship management" class="vitrum-img" loading="lazy" />
        </div>
    </div>
</div>

