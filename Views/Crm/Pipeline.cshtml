@{
    ViewData["Title"] = "Sales Pipeline Visualization | CRM | Pindah";
    ViewData["Description"] = "Visual sales pipeline management with Kanban and list views. Track deal flow, manage stages, and monitor sales velocity across all departments.";
    ViewData["Keywords"] = "sales pipeline, Kanban pipeline, deal flow, sales funnel visualization, pipeline management, sales velocity tracking";
    ViewData["CanonicalUrl"] = "https://pindah.org/crm/pipeline";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/crm">CRM</a></li>
                <li class="breadcrumb-item active">Pipeline</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">Sales Pipeline Visualization</h1>
        <p class="lead mb-4">
            Dynamic pipeline management that provides visual clarity on your sales funnel, enabling 
            teams to identify bottlenecks and accelerate revenue flow.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Visual Kanban and List Views</h2>
        <p>
            Experience your sales funnel through intuitive Kanban boards that visualize deal progression 
            from prospecting to close. Drag-and-drop deals between stages with instant updates to 
            pipeline values and weighted forecasts. For more detailed analysis, toggle to 
            comprehensive list views that allow for powerful filtering, sorting, and bulk action 
            management across the entire opportunity register.
        </p>
        <p>
            Multi-pipeline support allows organizations to manage distinct sales processes (e.g., 
            Enterprise Sales vs. Channel Partnerships) within a single unified platform, 
            ensuring that each team works with the stages and metrics relevant to their 
            specific go-to-market strategy.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Deal Velocity and Stagnation Alerts</h2>
        <p>
            Understand the movement of your deals with integrated sales velocity tracking. Identify 
            how long deals are spending in specific stages and receive automated alerts for 
            stagnant opportunities that haven't shown activity for a defined period. This 
            visibility enables sales managers to focus their energy on the most active 
            deals while proactively addressing those at risk of going cold.
        </p>
        <p>
            Visual cues on the pipeline board highlight deals that are overdue for action or 
            missing key criteria, ensuring that sales representatives maintain high levels of 
            pipeline hygiene and focus.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Pipeline Health and Funnel Analysis</h2>
        <p>
            Monitor conversion rates between stages to identify leakage points in your sales process. 
            Detailed funnel reports visualize the volume of deals needed at the top of the funnel 
            to reach revenue targets at the bottom, providing the data necessary for 
            accurate capacity planning and marketing budget allocation.
        </p>
        <p>
            This high-level view of pipeline health transforms the sales funnel from a black box 
            into a measurable and predictable engine for business growth.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/crm" class="text-decoration-none">← Back to CRM</a>
        </p>
    </div>
</div>
