@{
    ViewData["Title"] = "Account Management & B2B Profiles | CRM | Pindah";
    ViewData["Description"] = "Centralized account management for B2B relationships. Manage company profiles, parent-child hierarchies, transaction history, and document libraries.";
    ViewData["Keywords"] = "account management, B2B CRM, company profiles, account hierarchy, customer accounts, organizational relationship management";
    ViewData["CanonicalUrl"] = "https://pindah.org/crm/accounts";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/crm">CRM</a></li>
                <li class="breadcrumb-item active">Accounts</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">Account Management & B2B Profiles</h1>
        <p class="lead mb-4">
            A comprehensive 360-degree view of your business-to-business relationships, consolidating 
            every company interaction, document, and transaction into a single profile.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Centralized Company Intelligence</h2>
        <p>
            Build rich organizational profiles that go beyond basic contact information. Track company 
            revenue tiers, industry classifications, geographic footprints, and credit standing in a 
            unified master record. Every sales interaction, technical support case, and financial 
            transaction is aggregated at the account level, providing your team with the complete 
            operational context needed for professional B2B engagement.
        </p>
        <p>
            Custom fields and tagging allow for granular account segmentation, enabling targeted 
            marketing campaigns and tailored service levels based on organizational value and 
            sector-specific requirements.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Account Hierarchies and Parent-Child Mapping</h2>
        <p>
            Complex corporate structures require sophisticated relationship mapping. Our account 
            management system supports hierarchical mapping between parent companies, subsidiaries, 
            and regional branches. This structure allows you to track total organizational value 
            while managing local-level interactions with individual business units.
        </p>
        <p>
            Roll-up reporting provides a consolidated view of pipeline, revenue, and support history 
            across the entire corporate family, supporting strategic account management for 
            your large enterprise clients.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Document Repositories and History</h2>
        <p>
            Account-specific document libraries house every contract, proposal, service level agreement, 
            and pieces of official correspondence. This ensures that sales, legal, and finance 
            teams are always referencing the most current and authoritative versions of client 
            documents.
        </p>
        <p>
            A persistent interaction timeline captures every touchpoint from every department, 
            eliminating the departmental silos that lead to customer frustration. This 
            unified history ensures that anyone who picks up a client enquiry has the 
            full context of the relationship's evolution.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/crm" class="text-decoration-none">← Back to CRM</a>
        </p>
    </div>
</div>
