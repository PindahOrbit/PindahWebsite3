    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Pindah | ERP, Accounting & School Software Zimbabwe")</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Pindah is Zimbabwe's enterprise software company — ERP, accounting, school management (Frame), hospital systems, POS, payroll, CRM, and logistics for Harare and nationwide.")" />
    <meta name="keywords" content="@(ViewData["Keywords"] ?? "Pindah, Pindah ERP, Pindah Frame, ERP Zimbabwe, accounting software Zimbabwe, school management software Zimbabwe, hospital management system Zimbabwe, POS system Zimbabwe, payroll software Zimbabwe, CRM Zimbabwe, software company Zimbabwe, enterprise software Harare")" />
    <meta name="robots" content="@(ViewData["Robots"] ?? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1")" />
    <meta name="author" content="Pindah Private Limited" />
    <meta name="geo.region" content="ZW" />
    <meta name="geo.placename" content="Harare" />
    <link rel="canonical" href="@(ViewData["CanonicalUrl"] ?? Url.Action(ViewContext.RouteData.Values["action"]?.ToString(), ViewContext.RouteData.Values["controller"]?.ToString(), null, Context.Request.Scheme))" />
    <meta property="og:title" content="@(ViewData["Title"] ?? "Enterprise Software Solutions") | Pindah" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "Enterprise ERP, CRM, healthcare, education, manufacturing and logistics software for Zimbabwe and Southern Africa.")" />
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
    <meta property="og:url" content="@(ViewData["CanonicalUrl"] ?? Url.Action(ViewContext.RouteData.Values["action"]?.ToString(), ViewContext.RouteData.Values["controller"]?.ToString(), null, Context.Request.Scheme))" />
    <meta property="og:image" content="@(ViewData["OgImage"] ?? "https://storage.pindah.org/IMAGES/pindah-og-default.jpg")" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Pindah Private Limited" />
    <meta property="og:locale" content="en_ZW" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewData["Title"] ?? "Enterprise Software Solutions") | Pindah" />
    <meta name="twitter:description" content="@(ViewData["Description"] ?? "Enterprise ERP, CRM, healthcare, education, manufacturing and logistics software for Zimbabwe and Southern Africa.")" />
    <meta name="twitter:image" content="@(ViewData["OgImage"] ?? "https://storage.pindah.org/IMAGES/pindah-og-default.jpg")" />
    <link rel="icon" type="image/x-icon" href="https://storage.pindah.org/IMAGES/PindahBranding.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PindahWebsite3.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    @if (ViewData["StructuredData"] != null)
    {
        <script type="application/ld+json">@Html.Raw(ViewData["StructuredData"])</script>
    }
    else
    {
        <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@graph": [
                {
                    "@@type": "Organization",
                    "@@id": "https://pindah.org/#organization",
                    "name": "Pindah Private Limited",
                    "alternateName": ["Pindah", "Pindah Frame", "Pindah ERP"],
                    "url": "https://pindah.org",
                    "logo": "https://storage.pindah.org/IMAGES/pindah-og-default.jpg",
                    "email": "admin@pindah.org",
                    "telephone": "+263714856897",
                    "address": {
                        "@@type": "PostalAddress",
                        "addressLocality": "Harare",
                        "addressCountry": "ZW"
                    },
                    "areaServed": "Zimbabwe",
                    "sameAs": [
                        "https://courses.edtech.co.zw",
                        "https://frame.pindah.org",
                        "https://basa.pindah.org",
                        "https://edtech.co.zw"
                    ],
                    "knowsAbout": ["ERP software Zimbabwe", "Accounting software Zimbabwe", "School management software Zimbabwe", "Hospital management system Zimbabwe", "Heritage-Based Curriculum lessons Zimbabwe", "Pindah Course"]
                },
                {
                    "@@type": "WebSite",
                    "@@id": "https://pindah.org/#website",
                    "name": "Pindah",
                    "url": "https://pindah.org",
                    "publisher": { "@@id": "https://pindah.org/#organization" }
                }
            ]
        }
        </script>
    }

</head>
<body class="d-flex flex-column min-vh-100 site-body">
