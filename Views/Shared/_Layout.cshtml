<!DOCTYPE html>
<html lang="en-ZW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Enterprise Software Solutions Zimbabwe") | Pindah</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Pindah delivers enterprise ERP, CRM, healthcare, education, manufacturing and logistics software for organizations in Zimbabwe and Southern Africa.")" />
    <meta name="keywords" content="@(ViewData["Keywords"] ?? "enterprise software Zimbabwe, ERP Zimbabwe, CRM Harare, business management software Africa")" />
    <meta name="robots" content="@(ViewData["Robots"] ?? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1")" />
    <meta name="author" content="Pindah Private Limited" />
    <meta name="geo.region" content="ZW" />
    <meta name="geo.placename" content="Harare" />
    <link rel="canonical" href="@(ViewData["CanonicalUrl"] ?? Url.Action(ViewContext.RouteData.Values["action"]?.ToString(), ViewContext.RouteData.Values["controller"]?.ToString(), null, Context.Request.Scheme))" />
    <meta property="og:title" content="@(ViewData["Title"] ?? "Enterprise Software Solutions") | Pindah" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "Enterprise ERP, CRM, healthcare, education, manufacturing and logistics software for Zimbabwe and Southern Africa.")" />
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
    <meta property="og:url" content="@(ViewData["CanonicalUrl"] ?? Url.Action(ViewContext.RouteData.Values["action"]?.ToString(), ViewContext.RouteData.Values["controller"]?.ToString(), null, Context.Request.Scheme))" />
    <meta property="og:image" content="@(ViewData["OgImage"] ?? "https://storage.pindah.org/IMAGES/pindah-og-default.jpg")" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Pindah Private Limited" />
    <meta property="og:locale" content="en_ZW" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewData["Title"] ?? "Enterprise Software Solutions") | Pindah" />
    <meta name="twitter:description" content="@(ViewData["Description"] ?? "Enterprise ERP, CRM, healthcare, education, manufacturing and logistics software for Zimbabwe and Southern Africa.")" />
    <meta name="twitter:image" content="@(ViewData["OgImage"] ?? "https://storage.pindah.org/IMAGES/pindah-og-default.jpg")" />
    <link rel="icon" type="image/x-icon" href="https://storage.pindah.org/IMAGES/PindahBranding.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PindahWebsite3.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    @if (ViewData["StructuredData"] != null)
    {
        <script type="application/ld+json">@Html.Raw(ViewData["StructuredData"])</script>
    }
</head>
<body class="d-flex flex-column min-vh-100 site-body">
    <header>
        <div class="bg-white border-bottom py-2 site-header-top">
            <div class="container d-flex justify-content-between align-items-center">
                <a class="navbar-brand fw-bold text-dark mb-0 d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="https://storage.pindah.org/IMAGES/pindah_logo_webp.webp" alt="Pindah Private Limited - Enterprise Software Zimbabwe" width="24" height="24" class="d-inline-block" />
                    <span>Pindah</span>
                </a>
                <div class="d-flex align-items-center flex-wrap gap-2 justify-content-end">
                    <div class="small text-muted d-none d-md-block">
                        <span class="me-3">admin@pindah.org</span>
                        <span>+263 714 856 897</span>
                    </div>
                    <a class="btn btn-success btn-sm px-3 d-inline-flex align-items-center gap-1" href="https://wa.me/263714856897" target="_blank" rel="noopener noreferrer" aria-label="Contact Pindah on WhatsApp">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"/></svg>
                        WhatsApp
                    </a>
                    <a class="btn btn-primary btn-sm px-3" href="https://basa.pindah.org" rel="noopener noreferrer">Client Login</a>
                </div>
            </div>
        </div>
        <nav class="navbar navbar-expand-lg navbar-dark bg-mckinsey-nav py-0" aria-label="Main navigation">
            <div class="container">
                <button class="navbar-toggler border-0 py-2" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav w-100 justify-content-lg-between gap-lg-0 gap-1 py-2 py-lg-0">
                        <li class="nav-item"><a class="nav-link py-lg-3 px-0" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link py-lg-3 px-0" asp-controller="Erp" asp-action="Index">ERP</a></li>
                        <li class="nav-item"><a class="nav-link py-lg-3 px-0" asp-controller="Accounting" asp-action="Index">Accounting</a></li>
                        <li class="nav-item"><a class="nav-link py-lg-3 px-0" asp-controller="Crm" asp-action="Index">CRM</a></li>
                        <li class="nav-item"><a class="nav-link py-lg-3 px-0" asp-controller="Manufacturing" asp-action="Index">Manufacturing</a></li>
                        <li class="nav-item"><a class="nav-link py-lg-3 px-0" asp-controller="Hospital" asp-action="Index">Healthcare</a></li>
                        <li class="nav-item"><a class="nav-link py-lg-3 px-0" asp-controller="Sms" asp-action="Index">Education</a></li>
                        <li class="nav-item"><a class="nav-link py-lg-3 px-0" asp-controller="Logistics" asp-action="Index">Logistics</a></li>
                        <li class="nav-item"><a class="nav-link py-lg-3 px-0" asp-controller="Construction" asp-action="Index">Construction</a></li>
                        <li class="nav-item"><a class="nav-link py-lg-3 px-0" asp-controller="Insurance" asp-action="Index">Insurance</a></li>
                        <li class="nav-item"><a class="nav-link py-lg-3 px-0" asp-controller="Hr" asp-action="Index">HR</a></li>
                        <li class="nav-item"><a class="nav-link py-lg-3 px-0" asp-controller="News" asp-action="Index">Insights</a></li>
                        <li class="nav-item"><a class="nav-link py-lg-3 px-0" asp-controller="Downloads" asp-action="Index">Resources</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-3 pt-5">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer mt-auto py-5">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <img src="https://storage.pindah.org/IMAGES/pindah_logo_webp.webp" alt="Pindah" width="20" height="20" />
                        <span class="fw-bold text-white">Pindah Private Limited</span>
                    </div>
                    <p class="small mb-2">Enterprise software engineering and technology consulting. Harare, Zimbabwe.</p>
                    <p class="small mb-0">
                        <a href="mailto:admin@pindah.org">admin@pindah.org</a><br />
                        +263 714 856 897
                    </p>
                </div>
                <div class="col-6 col-lg-2">
                    <p class="small fw-bold text-white text-uppercase mb-2">Platform</p>
                    <ul class="list-unstyled small">
                        <li class="mb-1"><a asp-controller="Erp" asp-action="Index">ERP</a></li>
                        <li class="mb-1"><a asp-controller="Crm" asp-action="Index">CRM</a></li>
                        <li class="mb-1"><a asp-controller="Accounting" asp-action="Index">Accounting</a></li>
                        <li class="mb-1"><a asp-controller="Hr" asp-action="Index">HR</a></li>
                        <li class="mb-1"><a asp-controller="Scm" asp-action="Index">SCM</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <p class="small fw-bold text-white text-uppercase mb-2">Industries</p>
                    <ul class="list-unstyled small">
                        <li class="mb-1"><a asp-controller="Manufacturing" asp-action="Index">Manufacturing</a></li>
                        <li class="mb-1"><a asp-controller="Hospital" asp-action="Index">Healthcare</a></li>
                        <li class="mb-1"><a asp-controller="Sms" asp-action="Index">Education</a></li>
                        <li class="mb-1"><a asp-controller="Logistics" asp-action="Index">Logistics</a></li>
                        <li class="mb-1"><a asp-controller="Construction" asp-action="Index">Construction</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <p class="small fw-bold text-white text-uppercase mb-2">Resources</p>
                    <ul class="list-unstyled small">
                        <li class="mb-1"><a asp-controller="News" asp-action="Index">Insights</a></li>
                        <li class="mb-1"><a asp-controller="Downloads" asp-action="Index">Downloads</a></li>
                        <li class="mb-1"><a asp-controller="Zimsec" asp-action="Index">Zimsec</a></li>
                        <li class="mb-1"><a href="https://tenders.pindah.org" target="_blank" rel="noopener noreferrer">Tenders</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <p class="small fw-bold text-white text-uppercase mb-2">Company</p>
                    <ul class="list-unstyled small">
                        <li class="mb-1"><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                        <li class="mb-1"><a href="https://basa.pindah.org" rel="noopener noreferrer">Client Portal</a></li>
                        <li class="mb-1"><a href="https://wa.me/263714856897" target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
                    </ul>
                </div>
            </div>
            <div class="border-top border-secondary pt-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <p class="small mb-0">&copy; @DateTime.Now.Year Pindah Private Limited. All rights reserved.</p>
                    <p class="small mb-0">
                        <partial name="_LoginPartial" />
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <partial name="_SalesChat" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/sales-chat.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
