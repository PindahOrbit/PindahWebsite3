@model PindahWebsite3.Models.ModuleCardViewModel

<div class="col-md-6 col-lg-4">
    <div class="card h-100 home-solution-card">
        <div class="card-body">
            <i class="bi @Model.IconClass home-solution-icon" aria-hidden="true"></i>
            <h3 class="h6 fw-bold mb-1 card-title">@Model.Title</h3>
            <p class="small mb-2">@Model.Description</p>
            @if (!string.IsNullOrEmpty(Model.Href))
            {
                <a href="@Model.Href" class="text-decoration-none small fw-semibold" rel="@(Model.LinkRel ?? "noopener")">@Model.LinkText &rarr;</a>
            }
            else
            {
                <a asp-controller="@Model.Controller" asp-action="@Model.Action" class="text-decoration-none small fw-semibold">@Model.LinkText &rarr;</a>
            }
        </div>
    </div>
</div>
