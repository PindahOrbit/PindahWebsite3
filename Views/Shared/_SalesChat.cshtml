<button type="button"
        class="btn btn-primary sales-chat-fab"
        data-bs-toggle="offcanvas"
        data-bs-target="#salesChatOffcanvas"
        aria-controls="salesChatOffcanvas"
        aria-label="Chat with Pindah sales assistant">
    <i class="bi bi-chat-dots" aria-hidden="true"></i>
    <span class="sales-chat-fab-label">Chat</span>
</button>

<div class="offcanvas offcanvas-end sales-chat-offcanvas" tabindex="-1" id="salesChatOffcanvas" aria-labelledby="salesChatOffcanvasLabel">
    <div class="offcanvas-header border-bottom">
        <div>
            <h5 class="offcanvas-title mb-0" id="salesChatOffcanvasLabel">Pindah Assistant</h5>
            <p class="small text-muted mb-0">ERP, modules, and indicative pricing</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column p-0">
        <div id="sales-chat-messages" class="sales-chat-messages flex-grow-1 p-3">
            <div class="sales-chat-bubble sales-chat-bubble-assistant">
                <p class="mb-2">Hello — I am the Pindah sales assistant.</p>
                <p class="mb-2">Share your situation in one message if you like: industry, team size, modules you need, budget, and timeline.</p>
                <p class="mb-0 small text-muted">I will suggest modules and indicative pricing, and we can refine scope together.</p>
            </div>
        </div>

        <div id="sales-chat-handoff" class="sales-chat-handoff border-top p-3 d-none">
            <p class="small fw-semibold mb-2">Continue on WhatsApp</p>
            <p class="small text-muted mb-2" id="sales-chat-handoff-summary"></p>
            <a id="sales-chat-whatsapp-link" class="btn btn-success btn-sm w-100" href="#" target="_blank" rel="noopener noreferrer">
                Open WhatsApp with summary
            </a>
        </div>

        <div class="border-top p-3 bg-light">
            <label for="sales-chat-input" class="form-label small fw-semibold mb-1">Your message</label>
            <textarea id="sales-chat-input" class="form-control form-control-sm mb-2" rows="2" placeholder="e.g. We run a manufacturing company with 40 staff and need inventory and finance…"></textarea>
            <div class="d-flex justify-content-between align-items-center gap-2">
                <span class="small text-muted" id="sales-chat-status">Ready</span>
                <button type="button" class="btn btn-primary btn-sm" id="sales-chat-send">Send</button>
            </div>
        </div>
    </div>
</div>
