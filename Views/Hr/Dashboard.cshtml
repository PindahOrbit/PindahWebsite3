@{
    ViewData["Title"] = "HR Executive Performance Dashboard | Pindah";
    ViewData["Description"] = "Real-time executive dashboard for HR operations. Track organic staff strength, labor cost variance, upcoming statutory deadlines, and recruitment velocity.";
    ViewData["Keywords"] = "HR dashboard, headcount metrics, labor cost analysis, HR KPIs, turnover rate tracking, staff strength report";
    ViewData["CanonicalUrl"] = "https://pindah.org/hr/dashboard";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/hr">HR</a></li>
                <li class="breadcrumb-item active">Dashboard</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">HR Executive Dashboard</h1>
        <p class="lead mb-4">
            Transform high-volume personnel data into strategic organizational insight, providing 
            real-time visibility into the health and efficiency of your human capital.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Staff Strength & Headcount Analysis</h2>
        <p>
            Monitor real-time headcount metrics across all departments, grades, and locations. 
            The dashboard visualizes organic staff strength compared against budgeted 
            establishments, allowing management to identify resource gaps and 
            departmental over-staffing instantly. Grouped demographic data provides 
            the transparency needed for organizational diversity reporting and 
            succession planning models.
        </p>
        <p>
            Dynamic turnover rate analysis highlights attrition trends by department or 
            grade, providing early warning signals for potential cultural or management 
            challenges within specific segments of the organization.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Labor Cost & Financial Oversight</h2>
        <p>
            Gain absolute visibility into the organization's primary expenditure: labor. The 
            dashboard tracks total payroll spend—including allowances and statutory 
            contributions—compared against monthly and quarterly budgets. Identifying 
            unfavorable labor cost variances early allows for proactive resource 
            realignment before organizational profitability targets are impacted.
        </p>
        <p>
            Real-time tracking of upcoming statutory deadlines for ZIMRA, NSSA, and ZIMDEF 
            ensures that the organization remains consistently in good standing with 
            regulatory authorities, avoiding penalties and reputational risks.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Fulfillment & Velocity Metrics</h2>
        <p>
            Analyze the efficiency of your talent acquisition pipeline. Track 'Time to Hire' and 
            'Cost per Hire' across different roles and departments. This operational 
            velocity data allows HR management to identify bottlenecks in the recruitment 
            workflow and target improvements that maximize the speed of organizational 
            growth.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/hr" class="text-decoration-none">← Back to HR</a>
        </p>
    </div>
</div>
