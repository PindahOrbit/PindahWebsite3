    ViewData["Title"] = "Quotation & Proposal Management | Accounting | Pindah";
    ViewData["Description"] = "Professional quotation creation with automated conversion to sales orders, pricing rules, discount management, and customer approval tracking.";
    ViewData["Keywords"] = "quotation management, sales quotes, proposal software, quote to order, pricing rules, discount management";
    ViewData["CanonicalUrl"] = "https://pindah.org/accounting/quotations";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/accounting">Accounting</a></li>
                <li class="breadcrumb-item active">Quotations</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">Quotation Management</h1>
        <p class="lead mb-4">
            Professional proposal generation that transforms customer inquiries into formal quotations, 
            with streamlined conversion to orders and comprehensive tracking of acceptance rates.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Quote Creation</h2>
        <p>
            Quotations assemble from product catalogs with current pricing, inventory availability, 
            and configurable options. Template-based generation accelerates standard proposals while 
            custom builds accommodate unique requirements.
        </p>
        <p>
            Pricing rules apply customer-specific discounts, volume breaks, and promotional rates 
            automatically. Alternative options present good-better-best choices or optional add-ons 
            to increase average transaction value.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Customer Presentation</h2>
        <p>
            Professional quotation formats present pricing, terms, and specifications in customer-facing 
            documents branded to organizational standards. Electronic delivery with view tracking 
            indicates customer engagement timing.
        </p>
        <p>
            Expiration dates create urgency while protecting against stale pricing. Version control 
            maintains history when quotations require revision due to scope changes or updated pricing.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Conversion and Analysis</h2>
        <p>
            Accepted quotations convert to sales orders with single-click efficiency, preserving all 
            line-item detail and customer commitments. Rejected quotations capture loss reasons for 
            win-loss analysis and sales process improvement.
        </p>
        <p>
            Pipeline visibility aggregates open quotations by stage, value, and probability, supporting 
            revenue forecasting and resource allocation decisions. Conversion rate trends identify 
            quotation effectiveness and pricing competitiveness.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/accounting" class="text-decoration-none">← Back to Accounting</a>
        </p>
    </div>
</div>
