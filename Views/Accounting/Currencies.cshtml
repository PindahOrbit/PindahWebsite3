@{
    ViewData["Title"] = "Multi-Currency Management | Accounting | Pindah";
    ViewData["Description"] = "Comprehensive multi-currency support with automated exchange rate updates, real-time conversion, and foreign exchange gain/loss tracking for global operations.";
    ViewData["Keywords"] = "multi-currency, foreign exchange, exchange rates, currency conversion, forex management, multi-currency accounting";
    ViewData["CanonicalUrl"] = "https://pindah.org/accounting/currencies";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/accounting">Accounting</a></li>
                <li class="breadcrumb-item active">Currencies</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">Multi-Currency Management</h1>
        <p class="lead mb-4">
            Native multi-currency support enabling organizations to transact, report, and manage 
            cash across multiple currencies with automated exchange rate handling and foreign 
            exchange accounting.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Currency Configuration</h2>
        <p>
            Base currency selection establishes the functional currency for financial reporting, 
            while transaction currencies capture the original denomination of each transaction. 
            Unlimited transaction currencies support global operations without constraint.
        </p>
        <p>
            Exchange rate tables maintain current and historical rates for every currency pair, 
            with automated updates from market data feeds or manual entry for controlled rate 
            management. Rate effective dates ensure transactions apply appropriate conversion 
            factors based on timing.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Transaction Processing</h2>
        <p>
            Transactions enter in their original currency, with automatic conversion to base 
            currency for general ledger posting. Dual-currency tracking maintains both original 
            and functional currency amounts throughout the transaction lifecycle.
        </p>
        <p>
            Realized foreign exchange gains and losses compute automatically when transactions 
            settle at rates different from initial recording. Unrealized gains and losses 
            recognize for open foreign currency positions at period end, providing accurate 
            financial position representation.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Reporting and Compliance</h2>
        <p>
            Financial statements generate in base currency with transaction currency detail 
            available for audit and analysis. Currency revaluation reports identify positions 
            requiring adjustment and compute required gain-loss recognition.
        </p>
        <p>
            Exchange rate history provides audit trails for conversion factors applied to 
            historical transactions, supporting compliance with accounting standards for 
            foreign currency translation.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/accounting" class="text-decoration-none">← Back to Accounting</a>
        </p>
    </div>
</div>
