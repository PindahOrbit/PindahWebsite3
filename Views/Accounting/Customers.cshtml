    ViewData["CanonicalUrl"] = "https://pindah.org/accounting/customers";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/accounting">Accounting</a></li>
                <li class="breadcrumb-item active">Customers</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">Customer Management</h1>
        <p class="lead mb-4">
            Centralized customer master data that supports transaction processing, credit management, 
            and relationship intelligence across all customer touchpoints.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Master Data Management</h2>
        <p>
            Customer records capture essential information including billing and shipping addresses, 
            contact details, tax registrations, and preferred communication channels. Multiple addresses 
            accommodate customers with multiple locations or delivery points.
        </p>
        <p>
            Customer classification supports segmentation by industry, size, geography, or strategic 
            importance. Custom fields capture organization-specific attributes for filtering, 
            reporting, and analysis.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Credit and Risk Management</h2>
        <p>
            Credit limits define maximum exposure by customer, with enforcement at order entry to 
            prevent unauthorized shipments. Credit hold status blocks further transactions when 
            accounts exceed terms or demonstrate payment deterioration.
        </p>
        <p>
            Credit history tracks limit changes, payment patterns, and collection activity. 
            Automated scoring identifies customers requiring review based on aging, payment 
            velocity, and dispute frequency.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Transaction Visibility</h2>
        <p>
            Complete transaction history provides inquiry access to quotations, orders, invoices, 
            receipts, and credit notes across any time period. Drill-down capabilities reveal 
            line-item detail supporting customer service and dispute resolution.
        </p>
        <p>
            Relationship summaries present open order value, outstanding receivables, and 
            year-to-date revenue in executive-friendly formats for account review meetings 
            and strategic planning.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/accounting" class="text-decoration-none">← Back to Accounting</a>
        </p>
    </div>
</div>
