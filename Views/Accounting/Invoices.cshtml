    ViewData["Title"] = "Invoice Management & Processing | Accounting | Pindah";
    ViewData["Description"] = "Complete invoice lifecycle management from creation through collection, with automated reminders, payment tracking, and accounts receivable integration.";
    ViewData["Keywords"] = "invoice management, customer invoicing, accounts receivable, invoice processing, payment collection, billing";
    ViewData["CanonicalUrl"] = "https://pindah.org/accounting/invoices";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/accounting">Accounting</a></li>
                <li class="breadcrumb-item active">Invoices</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">Invoice Management</h1>
        <p class="lead mb-4">
            Comprehensive billing lifecycle management from invoice generation through payment 
            collection, with automation that accelerates cash flow and reduces administrative burden.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Invoice Generation</h2>
        <p>
            Invoices generate from sales orders, contracts, or manual entry, with line-item detail 
            supporting product codes, descriptions, quantities, and pricing. Tax computation applies 
            appropriate rates based on product classification and customer jurisdiction.
        </p>
        <p>
            Multiple invoice formats accommodate industry standards and customer preferences. 
            Branding customization maintains professional presentation while automated numbering 
            ensures sequential integrity and audit compliance.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Delivery and Tracking</h2>
        <p>
            Invoice delivery options include email transmission, portal access, and traditional mail, 
            with delivery confirmation tracking for dispute resolution. Customer acknowledgment capture 
            provides evidence of invoice receipt when collection issues arise.
        </p>
        <p>
            Real-time status visibility tracks invoices from draft through paid, with aging reports 
            highlighting collection priorities. Automated status updates inform sales and service 
            teams of customer payment standing.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Collection Management</h2>
        <p>
            Payment reminders escalate automatically based on due date and customer payment history, 
            with customizable message templates and delivery schedules. Promise-to-pay capture 
            records customer commitments for follow-up tracking.
        </p>
        <p>
            Receipt allocation matches payments to open invoices, with partial payment handling and 
            automatic discount calculation for early payment incentives. Unallocated receipts 
            remain visible for subsequent application or refund processing.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Credit Management</h2>
        <p>
            Credit notes handle returns, adjustments, and billing corrections with reference to 
            original invoices for audit trail integrity. Write-off workflows manage uncollectible 
            balances with appropriate authorization and documentation requirements.
        </p>
        <p>
            Dispute tracking maintains records of contested invoices, resolution steps, and final 
            disposition, supporting pattern analysis and process improvement initiatives.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/accounting" class="text-decoration-none">← Back to Accounting</a>
        </p>
    </div>
</div>
