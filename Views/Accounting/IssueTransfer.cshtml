    ViewData["CanonicalUrl"] = "https://pindah.org/accounting/issuetransfer";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/accounting">Accounting</a></li>
                <li class="breadcrumb-item active">Issue/Transfer</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">Issue and Transfer Management</h1>
        <p class="lead mb-4">
            Controlled inventory movement for internal consumption, departmental allocation, and 
            inter-location transfers, maintaining accurate stock positions and cost attribution 
            across the organization.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Internal Issues</h2>
        <p>
            Stock issues record inventory consumption for operational use, from office supplies 
            to raw materials for production. Issues allocate to cost centers, projects, or departmental 
            budgets, ensuring proper expense attribution and chargeback accuracy.
        </p>
        <p>
            Approval workflows enforce authorization levels based on value and material type, 
            preventing unauthorized consumption while enabling operational responsiveness. 
            Automated reorder suggestions trigger when issues bring stock below defined thresholds.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Inter-Location Transfers</h2>
        <p>
            Warehouse and location transfers move inventory between storage facilities while 
            maintaining visibility of in-transit quantities. Transfer documentation accompanies 
            shipments, providing receiving locations with advance notification of expected deliveries.
        </p>
        <p>
            Cost transfer options support transfer at cost, weighted average, or standard cost, 
            accommodating various organizational transfer pricing policies. Variance analysis 
            identifies discrepancies between shipped and received quantities for investigation.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Movement Tracking</h2>
        <p>
            Complete audit trails document every inventory movement with user identification, 
            timestamp, and business justification. Movement history inquiry supports forensic 
            investigation of stock discrepancies and provides visibility into consumption patterns.
        </p>
        <p>
            Batch and serial number tracking maintains traceability throughout internal movements, 
            preserving quality control and warranty management capabilities across location boundaries.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/accounting" class="text-decoration-none">← Back to Accounting</a>
        </p>
    </div>
</div>
