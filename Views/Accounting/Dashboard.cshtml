@{
    ViewData["Title"] = "Financial Dashboard | Accounting | Pindah";
    ViewData["Description"] = "Real-time financial dashboard providing comprehensive visibility into cash position, revenue trends, expense analysis, and key performance indicators for informed decision-making.";
    ViewData["Keywords"] = "financial dashboard, accounting dashboard, cash position, revenue trends, KPI tracking, financial analytics";
    ViewData["CanonicalUrl"] = "https://pindah.org/accounting/dashboard";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/accounting">Accounting</a></li>
                <li class="breadcrumb-item active">Dashboard</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">Financial Dashboard</h1>
        <p class="lead mb-4">
            Executive visibility into financial performance through real-time dashboards that aggregate data across 
            all accounting functions, presenting actionable insights for strategic decision-making.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Real-Time Financial Visibility</h2>
        <p>
            The financial dashboard consolidates information from every corner of the accounting system, 
            presenting a unified view of organizational financial health. Cash positions across multiple 
            accounts and currencies update in real time, providing immediate awareness of liquidity status 
            without requiring manual consolidation or spreadsheet manipulation.
        </p>
        <p>
            Revenue and expense trends visualize over custom periods, highlighting seasonal patterns, 
            growth trajectories, and areas requiring attention. Comparative analysis against budget 
            allocations and historical performance enables context for every figure displayed.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Key Performance Indicators</h2>
        <p>
            Essential metrics surface automatically on the dashboard, tailored to organizational priorities. 
            Working capital ratios, days sales outstanding, and inventory turnover provide immediate indicators 
            of operational efficiency. Gross and net margin trends track profitability evolution over time.
        </p>
        <p>
            Custom KPIs can be configured to reflect industry-specific metrics or internal performance targets. 
            Alert thresholds notify responsible personnel when metrics drift outside acceptable ranges, enabling 
            proactive intervention rather than reactive response.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Cash Flow Intelligence</h2>
        <p>
            Cash flow forecasting integrates historical patterns with scheduled obligations and anticipated 
            receipts, projecting liquidity positions weeks and months into the future. This visibility enables 
            treasury optimization, identifying surplus periods for investment and deficit periods requiring 
            credit facility activation.
        </p>
        <p>
            Receivables aging and payables schedules provide granular detail supporting collection prioritization 
            and payment timing decisions. The dashboard transforms raw transaction data into strategic treasury 
            intelligence.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/accounting" class="text-decoration-none">← Back to Accounting</a>
        </p>
    </div>
</div>
