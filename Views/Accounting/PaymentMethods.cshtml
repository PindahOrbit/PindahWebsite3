    ViewData["Keywords"] = "payment methods, payment processing, mobile money, bank transfer, card payments, payment reconciliation";
    ViewData["CanonicalUrl"] = "https://pindah.org/accounting/paymentmethods";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/accounting">Accounting</a></li>
                <li class="breadcrumb-item active">Payment Methods</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">Payment Methods and Processing</h1>
        <p class="lead mb-4">
            Comprehensive payment infrastructure supporting traditional and modern payment channels, 
            with automated reconciliation and transaction fee management.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Payment Channel Support</h2>
        <p>
            The system accommodates diverse payment methods including cash, cheques, electronic 
            funds transfer, credit and debit cards, mobile money, and emerging digital wallets. 
            Each method configures with appropriate processing parameters and reconciliation 
            procedures.
        </p>
        <p>
            Split payment handling allows customers to combine multiple methods for single 
            transactions, accommodating situations where credit limits or cash availability 
            require payment distribution across channels.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Reconciliation and Settlement</h2>
        <p>
            Payment method summaries aggregate transactions by channel for period-end reconciliation 
            against bank statements and processor reports. Discrepancy identification flags 
            transactions requiring investigation before financial statement recognition.
        </p>
        <p>
            Settlement tracking monitors funds in transit for methods with clearing delays, 
            providing visibility into actual versus available cash positions. Float management 
            optimizes working capital across payment channels with varying settlement timing.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Fee and Cost Management</h2>
        <p>
            Transaction fees by payment method capture processing costs for profitability analysis 
            and customer pricing decisions. Method-specific costs inform decisions about accepted 
            payment types and surcharge policies.
        </p>
        <p>
            Foreign exchange handling for international payments applies current rates with 
            gain-loss recognition, supporting multi-currency operations without manual rate 
            lookup and computation.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/accounting" class="text-decoration-none">← Back to Accounting</a>
        </p>
    </div>
</div>
