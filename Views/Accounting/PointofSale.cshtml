@{
    ViewData["Title"] = "Point of Sale System | Accounting | Pindah";
    ViewData["Description"] = "Integrated point of sale solution with real-time inventory updates, multi-payment method support, receipt generation, and seamless accounting synchronization.";
    ViewData["Keywords"] = "point of sale, POS system, retail POS, payment processing, sales receipt, inventory sync";
    ViewData["CanonicalUrl"] = "https://pindah.org/accounting/pointofsale";
    ViewData["OgImage"] = "https://storage.pindah.org/IMAGES/pindah-og-default.jpg";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/accounting">Accounting</a></li>
                <li class="breadcrumb-item active">Point of Sale</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h1 class="display-4 fw-bold mb-3">Point of Sale</h1>
        <p class="lead mb-4">
            Transaction processing at the retail frontline, connecting in-person sales to inventory 
            management and accounting systems with real-time synchronization and comprehensive audit trails.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Transaction Processing</h2>
        <p>
            The point of sale interface handles rapid transaction entry with barcode scanning, product 
            search, and quick-key shortcuts for high-volume environments. Line-item modifications 
            accommodate discounts, returns, and exchanges within the same transaction flow.
        </p>
        <p>
            Multiple payment methods process within single transactions, splitting payments across 
            cash, cards, mobile money, and account credits. Change calculation and drawer management 
            ensure cash handling accuracy.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Inventory Integration</h2>
        <p>
            Sales immediately decrement inventory positions, maintaining real-time stock visibility 
            across all channels. Low-stock alerts trigger at point of sale when items approach reorder 
            points, enabling immediate response to avoid stockouts.
        </p>
        <p>
            Serial number and batch tracking capture at sale time for products requiring traceability. 
            This integration supports warranty management and regulatory compliance without requiring 
            separate tracking systems.
        </p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-lg-12">
        <h2 class="h3 fw-bold mb-4">Receipts and Documentation</h2>
        <p>
            Printed and digital receipts provide transaction records with itemized details, payment 
            method breakdown, and return policy information. Receipt reprinting and lookup facilitate 
            post-transaction customer service and return processing.
        </p>
        <p>
            End-of-day reconciliation procedures match point of sale transaction logs against 
            payment method totals and cash drawer contents, identifying discrepancies for immediate 
            investigation and resolution.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 text-center">
        <p class="small mb-0">
            <a href="/accounting" class="text-decoration-none">← Back to Accounting</a>
        </p>
    </div>
</div>
