@model List<Download>
@{
    ViewData["Title"] = "Downloads";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Downloads</h1>
        <p class="text-muted mb-0">Manage public download listings.</p>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h6">Add download</h2>
        <form asp-action="Create" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-md-6">
                <label class="form-label small fw-semibold">Title</label>
                <input type="text" name="Title" class="form-control form-control-sm" required maxlength="200" />
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-semibold">File URL</label>
                <input type="url" name="FileUrl" class="form-control form-control-sm" required maxlength="500" />
            </div>
            <div class="col-12">
                <label class="form-label small fw-semibold">Description</label>
                <textarea name="Description" class="form-control form-control-sm" rows="2" maxlength="1000"></textarea>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">File type</label>
                <input type="text" name="FileType" class="form-control form-control-sm" maxlength="50" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Platform</label>
                <input type="text" name="Platform" class="form-control form-control-sm" maxlength="50" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Sort order</label>
                <input type="number" name="SortOrder" class="form-control form-control-sm" value="0" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input type="hidden" name="IsPublished" value="false" />
                    <input class="form-check-input" type="checkbox" name="IsPublished" value="true" id="downloadPublished" checked />
                    <label class="form-check-label small" for="downloadPublished">Published</label>
                </div>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary btn-sm">Add download</button>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive bg-white border rounded">
    <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
            <tr>
                <th>Title</th>
                <th>Platform</th>
                <th>Published</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <div class="fw-semibold">@item.Title</div>
                    <div class="small text-muted text-truncate" style="max-width: 360px;">@item.FileUrl</div>
                </td>
                <td>@item.Platform</td>
                <td>@(item.IsPublished ? "Yes" : "Draft")</td>
                <td class="text-end">
                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Remove this download?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
