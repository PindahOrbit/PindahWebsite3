@model NewsSaveModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Edit article" : "New article";
    bool isAdmin = ViewBag.IsAdmin == true;
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
}

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item"><a asp-action="Index">Articles</a></li>
        <li class="breadcrumb-item active">@(Model.Id.HasValue ? "Edit" : "Create")</li>
    </ol>
</nav>

<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<p class="text-muted small">Author is set automatically from your signed-in account — you do not need to enter it.</p>

<form asp-action="Save" method="post" id="article-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Heading" class="form-label fw-semibold"></label>
        <input asp-for="Heading" class="form-control" maxlength="300" required />
        <span asp-validation-for="Heading" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">Content</label>
        <div id="content-editor" class="bg-white" style="min-height: 280px;"></div>
        <input type="hidden" asp-for="Content" id="content" />
        <span asp-validation-for="Content" class="text-danger small"></span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="Slug" class="form-label fw-semibold">URL slug</label>
            <input asp-for="Slug" class="form-control" maxlength="400" placeholder="Auto from heading if blank" />
        </div>
        <div class="col-md-6">
            <label asp-for="CoverImageUrl" class="form-label fw-semibold">Cover image URL</label>
            <input asp-for="CoverImageUrl" class="form-control" maxlength="500" required />
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <label asp-for="Status" class="form-label fw-semibold"></label>
            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<NewsStatus>()"></select>
        </div>
        @if (isAdmin)
        {
            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check">
                    <input asp-for="IsFeatured" class="form-check-input" />
                    <label asp-for="IsFeatured" class="form-check-label">Feature on landing (max @CmsConstants.MaxFeaturedSlots)</label>
                </div>
            </div>
        }
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
    <script>
        const quill = new Quill('#content-editor', {
            theme: 'snow',
            modules: { toolbar: [[{ header: [1, 2, 3, false] }], ['bold', 'italic', 'underline', 'link'], [{ list: 'ordered' }, { list: 'bullet' }], ['clean']] }
        });
        const initial = document.getElementById('content').value || '';
        if (initial) {
            quill.root.innerHTML = initial;
        }
        document.getElementById('article-form').addEventListener('submit', function () {
            document.getElementById('content').value = quill.root.innerHTML;
        });
    </script>
}
