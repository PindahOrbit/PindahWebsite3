@page
@model PindahWebsite3.Areas.Identity.Pages.Account.Manage.UploadsModel
@{
    ViewData["Title"] = "My Contributions (Uploads)";
    ViewData["ActivePage"] = ManageNavPages.Uploads;
}

<h3 class="mb-4">@ViewData["Title"]</h3>

<div class="card mb-4 border-0">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="fas fa-upload me-2"></i> Upload New Document</h5>
    </div>
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label class="form-label">Category</label>
                <select name="CategoryId" class="form-select" required>
                    <option value="">-- Select Category --</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id">@cat.Name ( @(cat.ParentCategory?.Name ?? "Root") )</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Document Title</label>
                <input type="text" name="Title" class="form-control" placeholder="e.g. 2024 Nov Math Paper 1" required />
            </div>
            <div class="mb-3">
                <label class="form-label">PDF File</label>
                <input type="file" name="File" class="form-control" accept=".pdf" required />
            </div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-check me-1"></i> Upload Document</button>
        </form>
    </div>
</div>

<h4>My Uploaded Documents</h4>
@if (Model.MyDocuments.Any())
{
    <div class="table-responsive">
        <table class="table table-hover align-middle border">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in Model.MyDocuments)
                {
                    <tr>
                        <td>@doc.UploadDate.ToString("yyyy-MMM-dd")</td>
                        <td>@doc.Title</td>
                        <td>@(doc.Category?.Name)</td>
                        <td>
                            <a href="@doc.FilePath" class="btn btn-sm btn-outline-secondary" target="_blank">View PDF</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info border-0 mt-3">
        You haven't uploaded any documents yet.
    </div>
}
